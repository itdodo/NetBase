{
  "AllowedHosts": "*",

  "Jwt": {
    "Issuer": "NetBase",
    "Audience": "NetBase.Web",
    "SecretKey": "NetBase$Dev-SecretKey-0123456789-abcdef-PLACEHOLDER",
    "AccessTokenExpireMinutes": 120,
    "RefreshTokenExpireDays": 7
  },

  "Cors": {
    "AllowedOrigins": []
  },

  "Db": {
    "ConnectionString": "Server=localhost;Database=NetBase;Uid=sa;Pwd=Abcd1234;TrustServerCertificate=True;",
    "InitEnabled": true,
    "LogSql": true,
    "SlowSqlThresholdMs": 3000,
    "SnowflakeWorkerId": 1
  },

  "Cache": {
    "Provider": "Memory",
    "RedisConnectionString": "localhost:6379,abortConnect=false",
    "RedisKeyPrefix": "netbase:"
  },

  "RabbitMQ": {
    "Enabled": false,
    "ConnectionString": "amqp://guest:guest@localhost:5672",
    "DefaultExchange": "netbase.exchange"
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
