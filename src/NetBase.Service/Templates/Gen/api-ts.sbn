}

export const get{{ table.entity_name }}Page = (params: Partial<{{ table.entity_name }}Query>) =>
  request.get<never, PageResult<{{ table.entity_name }}>>('/biz/{{ table.module_name }}/page', { params })

export const get{{ table.entity_name }}Detail = (id: string) =>
  request.get<never, {{ table.entity_name }}>(`/biz/{{ table.module_name }}/${id}`)

export const create{{ table.entity_name }} = (data: {{ table.entity_name }}Save) =>
  request.post<never, string>('/biz/{{ table.module_name }}', data)

export const update{{ table.entity_name }} = (id: string, data: {{ table.entity_name }}Save) =>
  request.put<never, void>(`/biz/{{ table.module_name }}/${id}`, data)

export const delete{{ table.entity_name }} = (id: string) =>
  request.delete<never, void>(`/biz/{{ table.module_name }}/${id}`)

{{ if table.flow_doc }}
export const submit{{ table.entity_name }} = (id: string, flowCode = '') =>
  request.post<never, void>(`/biz/{{ table.module_name }}/${id}/submit`, { flowCode })
{{ end }}
